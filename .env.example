# Copiar este archivo como ".env" y ajustar los valores de su computador.
# El archivo .env NO se sube al repositorio ni se entrega (tiene datos privados).

# --- SQL Server ---
# Si usan una instancia con nombre, por ejemplo SQLEXPRESS: localhost\SQLEXPRESS
DB_SERVER=localhost
DB_NAME=DatosAbiertosDB
DB_DRIVER=ODBC Driver 18 for SQL Server

# yes = autenticación de Windows | no = usuario y contraseña de SQL Server
DB_TRUSTED=yes
DB_USER=
DB_PASSWORD=

# --- API datos.gov.co ---
# Hurto de automotores y motocicletas (Policía Nacional)
API_RESOURCE_ID=9vha-vh9n
# Opcional: token de aplicación de Socrata para evitar el error 429
API_APP_TOKEN=

# --- Flask ---
FLASK_SECRET_KEY=cambiar-por-una-clave-propia
